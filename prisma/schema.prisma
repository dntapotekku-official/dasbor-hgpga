// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  superadmin
  admin
  member
}

enum Category {
  non_pariwisata
  pariwisata
  parsial
}

enum AttributeType {
  string
  number
  date
  checkbox
}

model tbl_outlet {
  id                 Int       @id @default(autoincrement())
  uuid               String    @unique @db.Char(36)
  name               String    @db.VarChar(100)
  username           String    @unique @db.VarChar(100)
  password           String?   @db.Text
  is_username_change Boolean   @default(false)
  is_password_change Boolean   @default(false)
  category           Category
  excep              Boolean   @default(false)
  is_skip_sync       Boolean   @default(false)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  kepatuhan_sop_cctv          tbl_kepatuhan_sop_cctv[]
  outlet_insanku              tbl_outlet_insanku[]
  nilai_transaksi             tbl_nilai_transaksi[]
  nilai_transaksi_bulanan     tbl_nilai_transaksi_bulanan[]
  basket_size                 tbl_basket_size[]
  dilayani                    tbl_dilayani[]
  dilayani_bulanan            tbl_dilayani_bulanan[]
  nilai_magang                tbl_nilai_magang[]
}

model tbl_insanku {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @db.Char(36)
  nik                  String?   @db.VarChar(20)
  name                 String    @db.VarChar(100)
  username             String    @unique @db.VarChar(100)
  password             String?   @db.Text
  is_username_change   Boolean   @default(false)
  is_password_change   Boolean   @default(false)
  avatar               String?   @db.Text
  is_slip_gaji_account Boolean   @default(false)
  is_skip_sync         Boolean   @default(false)
  role                 Role
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime?

  outlet_insanku  tbl_outlet_insanku[]
  atribut_insanku tbl_atribut_insanku[]
  nilai_magang    tbl_nilai_magang[]
  target_gofitku  tbl_target_gofitku[]

  @@unique([nik, is_slip_gaji_account])
}

model tbl_admin {
  id                 Int       @id @default(autoincrement())
  uuid               String    @unique @db.Char(36)
  name               String    @db.VarChar(100)
  username           String    @unique @db.VarChar(100)
  password           String?   @db.Text
  is_username_change Boolean   @default(false)
  is_password_change Boolean   @default(false)
  role               Role
  avatar             String?   @db.Text
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  admin_menu_access tbl_admin_menu_access[]
}

model tbl_kepuasan_internal {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @db.Char(36)
  date       DateTime  @unique
  puas       Int       @default(0)
  tidak_puas Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deleted_at DateTime?
}

model tbl_kepatuhan_sop_cctv {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @db.Char(36)
  uuid_outlet String?   @db.Char(36)
  date        DateTime
  total       Int       @default(0)
  total_point Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  outlet tbl_outlet? @relation(fields: [uuid_outlet], references: [uuid], onDelete: SetNull, map: "fk_kepatuhan_sop_cctv_outlet")

  @@unique([uuid_outlet, date])
}

model tbl_outlet_insanku {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @db.Char(36)
  uuid_outlet  String?   @db.Char(36)
  uuid_insanku String?   @db.Char(36)
  is_skip_sync Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  outlet            tbl_outlet?             @relation(fields: [uuid_outlet], references: [uuid], onDelete: SetNull, map: "fk_outlet_insanku_outlet")
  insanku           tbl_insanku?            @relation(fields: [uuid_insanku], references: [uuid], onDelete: SetNull, map: "fk_outlet_insanku_insanku")
  penjualan_gofitku tbl_penjualan_gofitku[]

  @@unique([uuid_outlet, uuid_insanku])
  @@index([uuid_outlet])
  @@index([uuid_insanku])
}

model tbl_penjualan_gofitku {
  id                  Int       @id @default(autoincrement())
  uuid                String    @unique @db.Char(36)
  uuid_outlet_insanku String?   @db.Char(36)
  uuid_produk_gofitku String?   @db.Char(36)
  name                String    @db.VarChar(30)
  date                DateTime
  qty                 Int       @default(0)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  outlet_insanku tbl_outlet_insanku? @relation(fields: [uuid_outlet_insanku], references: [uuid], onDelete: SetNull, map: "fk_penjualan_gofitku_outlet_insanku")
  produk_gofitku tbl_produk_gofitku? @relation(fields: [uuid_produk_gofitku], references: [uuid], onDelete: SetNull, map: "fk_penjualan_gofitku_produk")

  @@index([uuid_outlet_insanku])
  @@index([uuid_produk_gofitku])
  @@index([date])
  @@index([uuid_outlet_insanku, date, deleted_at])
}

model tbl_produk_gofitku {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @db.Char(36)
  name       String    @db.VarChar(30)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  penjualan_gofitku tbl_penjualan_gofitku[]
}

model tbl_api_ai {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @db.Char(36)
  base_url   String    @db.VarChar(255)
  model      String    @db.VarChar(100)
  api_key    String    @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model tbl_prompt {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @db.Char(36)
  key        String    @db.VarChar(20)
  prompt     String    @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model tbl_target_gofitku {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @db.Char(36)
  uuid_insanku String?   @db.Char(36)
  value        Int       @default(0)
  start_date   DateTime
  end_date     DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  insanku tbl_insanku? @relation(fields: [uuid_insanku], references: [uuid], onDelete: SetNull, map: "fk_target_gofitku_insanku")

  @@index([uuid_insanku])
  @@index([uuid_insanku, start_date, end_date, deleted_at], map: "idx_target_gofitku_insanku_period")
}

model tbl_target_nilai_transaksi {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @db.Char(36)
  uuid_outlet String?   @db.Char(36)
  value       Decimal   @default(0) @db.Decimal(10, 2)
  start_date  DateTime
  end_date    DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
}

model tbl_target_basket_size {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @db.Char(36)
  uuid_outlet String?   @db.Char(36)
  value       Decimal   @default(0) @db.Decimal(10, 2)
  start_date  DateTime
  end_date    DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
}

model tbl_nilai_transaksi {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @db.Char(36)
  uuid_outlet   String?   @db.Char(36)
  active_key    String?   @unique @db.VarChar(80)
  date          DateTime
  total_revenue Decimal   @default(0) @db.Decimal(18, 2)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  outlet tbl_outlet? @relation(fields: [uuid_outlet], references: [uuid], onDelete: SetNull, map: "fk_nilai_transaksi_outlet")

  @@index([uuid_outlet])
  @@index([date])
}

model tbl_nilai_transaksi_bulanan {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @db.Char(36)
  uuid_outlet   String?   @db.Char(36)
  active_key    String?   @unique @db.VarChar(80)
  from_date     DateTime
  to_date       DateTime
  total_revenue Decimal   @default(0) @db.Decimal(18, 2)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  outlet tbl_outlet? @relation(fields: [uuid_outlet], references: [uuid], onDelete: SetNull, map: "fk_nilai_transaksi_bulanan_outlet")

  @@index([uuid_outlet])
  @@index([from_date])
  @@index([to_date])
}

model tbl_basket_size {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @db.Char(36)
  uuid_outlet String?   @db.Char(36)
  active_key  String?   @unique @db.VarChar(80)
  date        DateTime
  sku_qty     Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  outlet tbl_outlet? @relation(fields: [uuid_outlet], references: [uuid], onDelete: SetNull, map: "fk_basket_size_outlet")

  @@index([uuid_outlet])
  @@index([date])
}

model tbl_dilayani {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @db.Char(36)
  uuid_outlet String?   @db.Char(36)
  active_key  String?   @unique @db.VarChar(80)
  value       Int       @default(0)
  date        DateTime
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  outlet tbl_outlet? @relation(fields: [uuid_outlet], references: [uuid], onDelete: SetNull, map: "fk_dilayani_outlet")

  @@index([uuid_outlet])
  @@index([date])
}

model tbl_dilayani_bulanan {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @db.Char(36)
  uuid_outlet String?   @db.Char(36)
  active_key  String?   @unique @db.VarChar(80)
  value       Int       @default(0)
  from_date   DateTime
  to_date     DateTime
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  outlet tbl_outlet? @relation(fields: [uuid_outlet], references: [uuid], onDelete: SetNull, map: "fk_dilayani_bulanan_outlet")

  @@index([uuid_outlet])
  @@index([from_date])
  @@index([to_date])
}

model tbl_atribut_insanku {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @db.Char(36)
  uuid_insanku String?   @db.Char(36)
  uuid_atribut String?   @db.Char(36)
  value        String    @db.VarChar(100)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  insanku tbl_insanku?       @relation(fields: [uuid_insanku], references: [uuid], onDelete: SetNull, map: "fk_atribut_insanku_insanku")
  atribut tbl_kolom_atribut? @relation(fields: [uuid_atribut], references: [uuid], onDelete: SetNull, map: "fk_atribut_insanku_kolom_atribut")

  @@unique([uuid_insanku, uuid_atribut])
  @@index([uuid_insanku])
  @@index([uuid_atribut])
}

model tbl_kolom_atribut {
  id           Int           @id @default(autoincrement())
  uuid         String        @unique @db.Char(36)
  name         String        @db.VarChar(100)
  type         AttributeType
  is_attribute Boolean       @default(false)
  range_with   String?       @unique @db.Char(36)
  is_edit      Boolean       @default(false)
  is_view      Boolean       @default(false)
  order        Int           @default(0)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  deleted_at   DateTime?

  atribut_insanku tbl_atribut_insanku[]
}

model tbl_target_global {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @db.Char(36)
  key        String    @db.VarChar(100)
  value      Decimal   @default(0) @db.Decimal(10, 2)
  start_date DateTime
  end_date   DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@index([key])
}

model tbl_admin_menu_access {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @db.Char(36)
  uuid_admin String    @db.Char(36)
  key        String    @db.VarChar(100)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  admin tbl_admin @relation(fields: [uuid_admin], references: [uuid])

  @@unique([uuid_admin, key])
  @@index([uuid_admin])
}

model tbl_nilai_magang {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @db.Char(36)
  uuid_outlet  String?   @db.Char(36)
  uuid_insanku String?   @db.Char(36)
  active_key   String?   @unique @db.VarChar(100)
  value        Decimal   @default(0) @db.Decimal(10, 2)
  date         DateTime
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  outlet  tbl_outlet?  @relation(fields: [uuid_outlet], references: [uuid], onDelete: SetNull, map: "fk_nilai_magang_outlet")
  insanku tbl_insanku? @relation(fields: [uuid_insanku], references: [uuid], onDelete: SetNull, map: "fk_nilai_magang_insanku")

  @@index([uuid_outlet])
  @@index([date])
}
