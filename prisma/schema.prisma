// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  admin
  viewer
  member
}

model tbl_outlet {
  id           Int        @id @default(autoincrement())
  uuid         String     @unique @db.Char(36)
  name         String     @db.VarChar(255)
  is_skip_sync    Boolean    @default(false)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  deleted_at   DateTime?

  kepatuhan_sop_cctv tbl_kepatuhan_sop_cctv[]
  outlet_karyawan    tbl_outlet_karyawan[]
}

model tbl_karyawan {
  id                  Int         @id @default(autoincrement())
  uuid                String      @unique @db.Char(36)
  name                String      @db.VarChar(255)
  username            String      @unique @db.VarChar(100)
  password            String?     @db.Text
  is_username_change  Boolean     @default(false)
  is_password_change  Boolean     @default(false)
  avatar              String?     @db.Text
  is_skip_sync           Boolean     @default(false)
  role                Role
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  deleted_at          DateTime?

  outlet_karyawan     tbl_outlet_karyawan[]
}

model tbl_admin {
  id                  Int         @id @default(autoincrement())
  uuid                String      @unique @db.Char(36)
  name                String      @db.VarChar(255)
  username            String      @unique @db.VarChar(100)
  password            String?     @db.Text
  is_username_change  Boolean     @default(false)
  is_password_change  Boolean     @default(false)
  role                Role
  avatar              String?     @db.Text
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  deleted_at          DateTime?
}

model tbl_kepuasan_internal {
  id                  Int         @id @default(autoincrement())
  uuid                String      @unique @db.Char(36)
  date                DateTime    @unique
  puas                Int         @default(0)
  tidak_puas          Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deleted_at          DateTime?
}

model tbl_kepatuhan_sop_cctv {
  id                  Int         @id @default(autoincrement())
  uuid                String      @unique @db.Char(36)
  uuid_outlet         String      @db.Char(36)
  date                DateTime
  total               Int         @default(0)
  total_point         Int         @default(0)
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  deleted_at          DateTime?

  outlet              tbl_outlet  @relation(fields: [uuid_outlet], references: [uuid])

  @@unique([uuid_outlet, date])
}

model tbl_outlet_karyawan {
  id                  Int          @id @default(autoincrement())
  uuid                String       @unique @db.Char(36)
  uuid_outlet         String       @db.Char(36)
  uuid_karyawan       String       @db.Char(36)
  is_skip_sync           Boolean      @default(false)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt
  deleted_at          DateTime?

  outlet              tbl_outlet   @relation(fields: [uuid_outlet], references: [uuid])
  karyawan            tbl_karyawan @relation(fields: [uuid_karyawan], references: [uuid])

  @@unique([uuid_outlet, uuid_karyawan])
  @@index([uuid_outlet])
  @@index([uuid_karyawan])
}
